flowchart TD
    subgraph Phase1["Input: Extraction (Phase 1)"]
        IR_Unres["<b>Extracted IR Modules</b><br/>Syntactic entities with unresolved string references"]
    end

    subgraph Phase2a["Phase 2a: Query Building (ρ_build — Local & Lexical)"]
        Stack["<b>Symbol Stack (Δ)</b><br/>Ephemeral frames tracking local variables & parameters"]
        Subst["<b>Lexical Substitution (substitute_type)</b><br/>Resolves local names & encodes paths as navigation queries"]
        IR_Queries["<b>Intermediate IR</b><br/>Body references lowered to Query Algebra (Find, Extract, Call)"]
        
        IR_Unres --> Subst
        Stack --> Subst
        Subst --> IR_Queries
    end

    subgraph Phase2b["Phase 2b: Query Execution (ρ_exec — Global & Topological)"]
        Tree["<b>Scope Tree Construction (ScopeTree::build)</b><br/>Registers global workspace hierarchy, types & flattens ImplBlocks"]
        Exec["<b>Query Executor (evaluate_query)</b><br/>Evaluates queries via lexical climbing, inheritance & imports"]
        IR_Res["<b>Resolved IR Modules (D_res)</b><br/>Fully resolved semantic pointers ready for Graph Construction"]

        Tree -->|Scope Tree E| Exec
        Exec --> IR_Res
    end

    IR_Queries --> Tree
    IR_Queries --> Exec

