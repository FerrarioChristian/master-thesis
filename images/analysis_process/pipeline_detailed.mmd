flowchart LR
    %% Domains / Artifacts
    W[/"Workspace &Wscr;<br/>(Source Files)"/]
    D(["Unresolved IR &Dscr;<br/>(&tau; = Unresolved)"])
    D_res(["Resolved IR &Dscr;<sub>res</sub><br/>(&tau; = Resolved, Ext, Prim...)"])
    G[("Dependency Graph &Gscr;<br/>(V, E)")]

    %% Phase 1
    subgraph P1["Phase 1: Syntactic Extraction (&epsilon;)"]
        direction TB
        TS["Tree-sitter Parsing<br/>(Concrete Syntax Tree)"]
        HE["Heuristic Extraction<br/>& Module Strategies"]
        TS --> HE
    end

    %% Phase 2
    subgraph P2["Phase 2: Name Resolution (&rho;)"]
        direction TB
        QB["Query Building (&rho;<sub>build</sub>)<br/><i>Symbol Stack &Delta;</i>"]
        QE["Query Execution (&rho;<sub>exec</sub>)<br/><i>Scope Tree &Escr; & Context &Gamma;</i>"]
        QB --> QE
    end

    %% Phase 3
    subgraph P3["Phase 3: Graph Construction (&gamma;)"]
        direction TB
        NF["Node Flattening (V)<br/><i>Component vertices</i>"]
        EG["Edge Generation (E)<br/><i>15 Dependency kinds</i>"]
        NF ~~~ EG
    end

    %% Data Flow
    W --> P1
    P1 --> D
    D --> P2
    P2 --> D_res
    D_res --> P3
    P3 --> G

    %% Styling
    style W fill:#f5f5f5,stroke:#757575,stroke-width:1px
    style D fill:#fff9c4,stroke:#fbc02d,stroke-width:1px
    style D_res fill:#e8f5e9,stroke:#2e7d32,stroke-width:1px
    style G fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px

    style P1 fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style P2 fill:#fffde7,stroke:#f57f17,stroke-width:2px
    style P3 fill:#ede7f6,stroke:#4527a0,stroke-width:2px
