%%{init: {
    'flowchart': {
    'wrappingWidth': 200
  },
  'themeVariables': {'fontSize': '32px', 'edgeLabelBackground':'#FFFFFF'}
  }}%%
flowchart LR
    IR["<b>Resolved <br/> IR</b>"]

    subgraph Pipeline ["Graph Construction Pipeline (&gamma;)"]
        direction LR

        subgraph Pass1 ["Node Extraction"]
            direction TB
            P1_Trav["Recursive Tree Traversal"]
            P1_QName["Qualified Name Computation"]
            P1_Nodes["Workspace Vertices (V)<br/><i>Modules, Types, Functions</i>"]
            
            P1_Trav --> P1_QName --> P1_Nodes
        end

        subgraph Pass2 ["Edge Generation"]
            direction TB
            P2_Trav["Second Tree Traversal"]
            P2_Filter["Reference Filtering<br/><i>Skip Unresolved</i>"]
            P2_Emit["Dependency Edge Emission (E) <br/><i>Directed Relations</i>"]
            
            P2_Trav --> P2_Filter --> P2_Emit
        end

        subgraph PostProc ["Post-Processing"]
            direction TB
            PP_Close["Referential Closure<br/><i>Primitives & External Endpoints</i>"]
            PP_Dedup["Edge Deduplication<br/><i>Prune Duplicates</i>"]
            
            PP_Close --> PP_Dedup
        end

        Pass1 --> Pass2 --> PostProc
    end

    G[("<b>Dependency Graph</b> <br/>G = (V, E)<br/><i>Flat directed multigraph</i>")]

    IR --> Pipeline
    Pipeline --> G

    style IR fill:#fff9c4,stroke:#fbc02d,stroke-width:2px
    style G fill:#ede7f6,stroke:#512da8,stroke-width:2px
    style Pipeline fill:#fafafa,stroke:#333333,stroke-width:2px,stroke-dasharray: 5 5
    style Pass1 fill:#e3f2fd,stroke:#1976d2,stroke-width:1.5px
    style Pass2 fill:#e8f5e9,stroke:#388e3c,stroke-width:1.5px
    style PostProc fill:#fff3e0,stroke:#f57c00,stroke-width:1.5px

    style P1_Trav fill:#ffffff,stroke:#1976d2,stroke-width:1px
    style P1_QName fill:#ffffff,stroke:#1976d2,stroke-width:1px
    style P1_Nodes fill:#ffffff,stroke:#1976d2,stroke-width:1px

    style P2_Trav fill:#ffffff,stroke:#388e3c,stroke-width:1px
    style P2_Filter fill:#ffffff,stroke:#388e3c,stroke-width:1px
    style P2_Emit fill:#ffffff,stroke:#388e3c,stroke-width:1px

    style PP_Close fill:#ffffff,stroke:#f57c00,stroke-width:1px
    style PP_Dedup fill:#ffffff,stroke:#f57c00,stroke-width:1px
